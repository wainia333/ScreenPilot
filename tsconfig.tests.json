{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "types": ["node", "vite/client", "vitest/globals", "@testing-library/jest-dom"]
  },
  "include": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/shared/testing",
    "tests",
    "vite.config.ts",
    "playwright.config.ts"
  ],
  "exclude": ["src/vendor/kivio-screenshot"]
}
