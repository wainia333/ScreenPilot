{
  "name": "screenpilot",
  "private": true,
  "version": "0.1.4",
  "description": "ScreenPilot desktop screen assistant",
  "author": "Wainia",
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0 <25"
  },
  "scripts": {
    "dev": "tauri dev",
    "dev:ui": "vite --host 127.0.0.1 --port 5713",
    "build": "tauri build",
    "build:ui": "vite build",
    "check": "npm run check:frontend && npm run check:rust",
    "check:frontend": "npm run typecheck && npm run lint -- --max-warnings 0",
    "check:rust": "npm run rust:fmt && npm run rust:clippy",
    "verify": "npm run verify:frontend && npm run verify:rust",
    "verify:frontend": "npm run check:frontend && npm run test:coverage && npm run scan",
    "verify:rust": "npm run rust:fmt && npm run rust:test && npm run rust:clippy",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --locked --all-targets -- -D warnings",
    "release:prepare": "npm run verify && npm run build:ui",
    "release": "tauri build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tests.json",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "scan": "node scripts/verify-project.mjs",
    "vendor:lock": "node scripts/update-vendor-integrity.mjs",
    "audit:dependencies": "npm audit",
    "audit:rust": "cargo audit --file src-tauri/Cargo.lock",
    "smoke:windows": "pwsh -NoProfile -File scripts/smoke-windows.ps1",
    "release:signed:windows": "pwsh -NoProfile -File scripts/build-signed-windows-release.ps1",
    "verify:signatures:windows": "pwsh -NoProfile -File scripts/verify-authenticode.ps1",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tailwindcss/typography": "0.5.19",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "2.3.2",
    "katex": "0.18.1",
    "lucide-react": "1.27.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.0",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/katex": "0.16.8",
    "@types/node": "24.10.11",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "fast-check": "4.3.0",
    "globals": "16.5.0",
    "jsdom": "29.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
